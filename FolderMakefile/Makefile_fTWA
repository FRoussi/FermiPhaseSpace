
# Compiler
CXX = CC


# Installation directory
WORK_DIR = /users/roussefr/
LIB_DIR = $(WORK_DIR)opt/

# Directories
ARMADILLO_INCLUDE_DIR = $(LIB_DIR)armadillo/include
ARMADILLO_LIB_DIR = $(LIB_DIR)armadillo/lib64
#OPENMP_INCLUDE_DIR = $(LIB_DIR)openmp/include
#OPENMP_LIB_DIR = $(LIB_DIR)openmp/lib

# Compiler flags
CXXFLAGS = -I$(ARMADILLO_INCLUDE_DIR)  -std=c++14 -Wshadow -Wall -pedantic -Og -fopenmp
#CXXFLAGS = -I$(ARMADILLO_INCLUDE_DIR) -I$(OPENMP_INCLUDE_DIR) -std=c++14 -Wshadow -Wall -pedantic -Og -fopenmp
LDFLAGS = -L$(ARMADILLO_LIB_DIR) -larmadillo 
#LDFLAGS = -L$(ARMADILLO_LIB_DIR) -larmadillo  -I$(OPENMP_LIB_DIR) -lomp


# Source files
SRCS = ./src/jsoncpp.cpp ./src/FHLattice.cpp ./src/FHSystem.cpp ./src/FHCoreHole.cpp \
       ./src/FHTunnelingInteraction.cpp ./src/FHCoulombInteraction.cpp \
       ./src/FHExternalPotential.cpp ./src/FHExternalPotentialPulse.cpp \
       ./src/ResultWriterTxt.cpp ./src/ResultWriterJson.cpp ./src/FHSolver.cpp \
       ./src/FHfTWASolver.cpp ./src/FHfTWAMPISolver.cpp \
       fps_fTWA_MPI.cpp

# Object files
OBJS = $(SRCS:.cpp=.o)

# Executable
EXEC = fps_fTWA

# Rules
all: $(EXEC)

$(EXEC): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(EXEC)

.PHONY: all clean

