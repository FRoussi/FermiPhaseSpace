
# Compiler
CXX = CC

# Directories
ARMADILLO_INCLUDE_DIR = /users/roussefr/opt/armadillo/include
ARMADILLO_LIB_DIR = /users/roussefr/opt/armadillo/lib64
#OPENMP_INCLUDE_DIR = /users/roussefr/opt/openmp/include
#OPENMP_LIB_DIR = /users/roussefr/opt/openmp/lib
#FPS_DIR = /users/roussefr/FermiPhaseSpace 

# Compiler flags
CXXFLAGS = -I$(ARMADILLO_INCLUDE_DIR)  -std=c++14 -Wshadow -Wall -pedantic -Og -fopenmp
LDFLAGS = -L$(ARMADILLO_LIB_DIR) -larmadillo 
#CXXFLAGS = -I$(ARMADILLO_INCLUDE_DIR) -I$(OPENMP_INCLUDE_DIR) -std=c++14 -Wshadow -Wall -pedantic -Og -fopenmp
#LDFLAGS = -L$(ARMADILLO_LIB_DIR) -larmadillo -L$(OPENMP_LIB_DIR) -lomp


# Source files
SRCS = ./src/jsoncpp.cpp ./src/FHSystem.cpp ./src/FHLattice.cpp \
       ./src/FHTunnelingInteraction.cpp ./src/FHCoulombInteraction.cpp \
       ./src/FHExternalPotential.cpp ./src/FHExternalPotentialPulse.cpp \
       ./src/FHExternalPotentialConstant.cpp ./src/FHExternalPotentialCoreHole.cpp \
       ./src/ResultWriterTxt.cpp ./src/ResultWriterJson.cpp \
       ./src/FHSolver.cpp ./src/FHHFSolver.cpp ./fps_HF.cpp

# Object files
OBJS = $(SRCS:.cpp=.o)

# Executable
EXEC = fps_HF

# Rules
all: $(EXEC)

$(EXEC): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(EXEC)

.PHONY: all clean

