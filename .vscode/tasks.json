{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "g++ build all files and run",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",   
                "${workspaceFolder}/src/jsoncpp.cpp",
                "${workspaceFolder}/src/FHSystem.cpp",
                "${workspaceFolder}/src/FHExternalPotential.cpp",
                "${workspaceFolder}/src/FHExternalPotentialPulse.cpp",
                "${workspaceFolder}/src/FHSolver.cpp",
                "${workspaceFolder}/src/ResultWriterTxt.cpp",
                "${workspaceFolder}/src/ResultWriterJson.cpp",
                "${workspaceFolder}/src/FHEDSolver.cpp",
                "${workspaceFolder}/src/FHfTWASolver.cpp",
                "${workspaceFolder}/src/FHGPSRSolver.cpp",
                "${workspaceFolder}/src/FHHFSolver.cpp",
                "${workspaceFolder}/fps.cpp",
                "-o",
                "${fileDirname}/fps",    
                "-larmadillo",
                "-fopenmp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group":  "build",
            "detail": "Global compile and run. compiler: /usr/bin/g++, openmp."
        },
        {
            "type": "cppbuild",
            "label": "mpic++ build of the fTWA solver, MPI version.",
            "command": "/usr/bin/mpic++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",   
                "${workspaceFolder}/src/jsoncpp.cpp",
                "${workspaceFolder}/src/FHSystem.cpp",
                "${workspaceFolder}/src/FHExternalPotential.cpp",
                "${workspaceFolder}/src/FHExternalPotentialPulse.cpp",
                "${workspaceFolder}/src/FHSolver.cpp",
                "${workspaceFolder}/src/ResultWriterTxt.cpp",
                "${workspaceFolder}/src/ResultWriterJson.cpp",
                "${workspaceFolder}/src/FHfTWASolver.cpp",
                "${workspaceFolder}/src/FHfTWAMPISolver.cpp",
                "${workspaceFolder}/fps_fTWA_MPI.cpp",
                "-o",
                "${fileDirname}/fps_fTWA_MPI",    
                "-larmadillo",
                "-fopenmp",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group":  "build",
            "detail": "fTWA compile. compiler: /usr/bin/mpic++, openmp, mpi."
        },
        {
            "type": "cppbuild",
            "label": "g++ build of the Hartree-Fock solver.",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",   
                "${workspaceFolder}/src/jsoncpp.cpp",
                "${workspaceFolder}/src/FHSystem.cpp",
                "${workspaceFolder}/src/FHExternalPotential.cpp",
                "${workspaceFolder}/src/FHExternalPotentialPulse.cpp",
                "${workspaceFolder}/src/FHSolver.cpp",
                "${workspaceFolder}/src/ResultWriterTxt.cpp",
                "${workspaceFolder}/src/ResultWriterJson.cpp",
                "${workspaceFolder}/src/FHHFSolver.cpp",
                "${workspaceFolder}/fps_HF.cpp",
                "-o",
                "${fileDirname}/fps_HF",    
                "-larmadillo",
                "-fopenmp",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group":  "build",
            "detail": "HF compile. compiler: /usr/bin/g++, openmp."
        },
        {
            "type": "cppbuild",
            "label": "g++ build the system maker",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g", 
                "${workspaceFolder}/src/jsoncpp.cpp",
                "${workspaceFolder}/src/FHExternalPotential.cpp",
                "${workspaceFolder}/src/FHExternalPotentialPulse.cpp",
                "${workspaceFolder}/src/FHSystem.cpp",
                "${workspaceFolder}/makeSitesSystem.cpp",
                "-o",
                "${fileDirname}/makeSitesSystem",
                "-larmadillo"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group":"build",
            "detail": "Compile the system maker: /usr/bin/g++."
        },
        {
            "type": "cppbuild",
            "label": "g++ build the Wannier Tools writer",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g", 
                "${workspaceFolder}/src/jsoncpp.cpp",
                "${workspaceFolder}/src/FHExternalPotential.cpp",
                "${workspaceFolder}/src/FHExternalPotentialPulse.cpp",
                "${workspaceFolder}/src/FHSystem.cpp",
                "${workspaceFolder}/makeWannierFile.cpp",
                "-o",
                "${fileDirname}/makeWannierFile",
                "-larmadillo"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group":"build",
            "detail": "Compile the system maker: /usr/bin/g++."
        }
    ]
}